generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RestaurantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

enum SubscriptionStatus {
  PENDING
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  VOIDED
  ERROR
}

enum PaymentMethodType {
  CARD
  NEQUI
}

enum PaymentMethodStatus {
  ACTIVE
  INACTIVE
}

enum PaymentProvider {
  WOMPI
}

// ============================================================
// USER
// ============================================================

model User {
  id           String @id @default(cuid())
  email        String @unique @db.VarChar(191)
  passwordHash String @db.VarChar(255)
  firstName    String @db.VarChar(100)

  status UserStatus @default(ACTIVE)

  termsAcceptedAt   DateTime?
  privacyAcceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships RestaurantMember[]
  refreshTokens RefreshToken[]

  @@index([status])
  @@map("users")
}

// ============================================================
// RESTAURANT
// ============================================================

model Restaurant {
  id String @id @default(cuid())

  name        String  @db.VarChar(150)
  description String? @db.VarChar(500)
  phone       String? @db.VarChar(30)

  address    String  @db.VarChar(255)
  city       String  @db.VarChar(100)
  department String? @db.VarChar(100)

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  website   String? @db.VarChar(255)
  instagram String? @db.VarChar(100)
  facebook  String? @db.VarChar(255)

  status RestaurantStatus @default(ACTIVE)

  cuisineId    String?
  priceRangeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cuisine    Cuisine?    @relation(fields: [cuisineId], references: [id])
  priceRange PriceRange? @relation(fields: [priceRangeId], references: [id])

  memberships    RestaurantMember[]
  subscriptions  Subscription[]
  paymentMethods PaymentMethod[]

  @@index([city])
  @@index([department])
  @@index([status])
  @@index([cuisineId])
  @@index([priceRangeId])
  @@map("restaurants")
}

// ============================================================
// RESTAURANT MEMBERS
// ============================================================

model RestaurantMember {
  id           String         @id @default(cuid())
  userId       String
  restaurantId String
  role         MembershipRole @default(STAFF)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([restaurantId, role])
  @@map("restaurant_members")
}

// ============================================================
// CUISINES
// ============================================================

model Cuisine {
  id   String @id @default(cuid())
  code String @unique @db.VarChar(50)
  name String @db.VarChar(100)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  restaurants Restaurant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("cuisines")
}

// ============================================================
// PRICE RANGES
// ============================================================

model PriceRange {
  id     String @id @default(cuid())
  code   String @unique @db.VarChar(20)
  symbol String @db.VarChar(10)
  name   String @db.VarChar(100)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  restaurants Restaurant[]

  @@index([isActive, sortOrder])
  @@map("price_ranges")
}

// ============================================================
// PLANS
// ============================================================

model Plan {
  id String @id @default(cuid())

  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String? @db.VarChar(500)

  priceAmount BigInt
  currency    String @default("COP") @db.Char(3)

  billingInterval BillingInterval @default(MONTH)
  trialDays       Int             @default(0)

  maxUsers            Int?
  maxActivePromotions Int?
  maxRestaurants      Int?

  requiresPayment Boolean @default(false)
  isFeatured      Boolean @default(false)
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  features      PlanFeature[]

  @@index([isActive, sortOrder])
  @@map("plans")
}

// ============================================================
// FEATURES
// ============================================================

model Feature {
  id String @id @default(cuid())

  code        String  @unique @db.VarChar(80)
  name        String  @db.VarChar(150)
  description String? @db.VarChar(500)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans PlanFeature[]

  @@map("features")
}

// ============================================================
// PLAN FEATURES
// ============================================================

model PlanFeature {
  planId    String
  featureId String

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
  @@map("plan_features")
}

// ============================================================
// SUBSCRIPTIONS
// ============================================================

model Subscription {
  id String @id @default(cuid())

  restaurantId String
  planId       String

  status SubscriptionStatus @default(TRIALING)

  startsAt    DateTime
  trialEndsAt DateTime?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  canceledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  plan       Plan       @relation(fields: [planId], references: [id])

  payments Payment[]

  @@index([restaurantId, status])
  @@index([planId])
  @@map("subscriptions")
}

// ============================================================
// PAYMENT METHODS
// ============================================================

model PaymentMethod {
  id String @id @default(cuid())

  restaurantId String

  provider PaymentProvider     @default(WOMPI)
  type     PaymentMethodType
  status   PaymentMethodStatus @default(ACTIVE)

  providerPaymentSourceId String @unique @db.VarChar(191)

  brand    String? @db.VarChar(50)
  lastFour String? @db.VarChar(4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  payments Payment[]

  @@index([restaurantId, status])
  @@map("payment_methods")
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id String @id @default(cuid())

  subscriptionId  String
  paymentMethodId String?

  provider PaymentProvider @default(WOMPI)

  providerTransactionId String? @unique @db.VarChar(191)
  reference             String  @unique @db.VarChar(100)

  amount   BigInt
  currency String @default("COP") @db.Char(3)

  status PaymentStatus @default(PENDING)

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription  Subscription   @relation(fields: [subscriptionId], references: [id])
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  @@index([subscriptionId, status])
  @@index([status])
  @@map("payments")
}

// ============================================================
// RefreshToken
// ============================================================


model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(255)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
